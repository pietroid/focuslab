  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Focuslab (DEV)",
      "request": "launch",
      "type": "dart",
      "program": "apps/lab/lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart"
      ]
    },
    {
      "name": "Launch Focuslab (DEV) Profile",
      "request": "launch",
      "type": "dart",
      "program": "apps/lab/lib/main_development.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main_development.dart",
        "--profile",
      ]
    },
    {
      "name": "Launch Focus",
      "request": "launch",
      "type": "dart",
      "program": "apps/focus/lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart"
      ]
    },
    {
      "name": "Launch Focus Profile",
      "request": "launch",
      "type": "dart",
      "program": "apps/focus/lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--target",
        "lib/main.dart",
        "--profile",
      ]
    },
  ]
}